{
  "about": "Official regulatory data for the EV range simulator: EU WLTP registrations and US EPA measured road load. Manufacturer figures are kept separately in data/manufacturer_facts.json. See docs/data-sources.md.",
  "sources": {
    "eu_wltp": {
      "publisher": "European Environment Agency",
      "dataset": "Monitoring of CO2 emissions from passenger cars, 2024 final data (Regulation (EU) 2019/631)",
      "access": "https://discodata.eea.europa.eu/ table [CO2Emission].[latest].[co2cars_2024Fv30]",
      "doi": "https://doi.org/10.2909/5018ec17-2348-4c92-8761-6f2377bbd1c0",
      "licence": "CC BY 4.0; copyright holder: Directorate-General for Climate Action (DG CLIMA)",
      "field_definitions": "EEA table definition: M = mass in running order, Mt = WLTP test mass, Z = electric energy consumption (Wh/km), Zr = electric range (km), R = registrations",
      "tool": "tools/eea_query.py"
    },
    "us_road_load": {
      "publisher": "US Environmental Protection Agency",
      "dataset": "Test Car List Data Files",
      "page": "https://www.epa.gov/compliance-and-fuel-economy-data/data-cars-used-testing-fuel-economy",
      "reference_conditions": "20 C, 98.21 kPa, no wind (40 CFR 1066.305)",
      "conversions": "1 lbf = 4.4482216152605 N, 1 mph = 0.44704 m/s, 1 lb = 0.45359237 kg (exact; NIST SP 811)",
      "tool": "tools/epa_roadload.py"
    }
  },
