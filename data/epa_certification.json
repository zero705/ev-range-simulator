{
  "about": "Battery-side (DC) and mains-side (AC) energy measured in the EPA certification test of each car, read from the EPA certificate summaries by tools/epa_certification.py. See docs/data-sources.md.",
  "definitions": {
    "usable_battery_energy_wh": "total DC energy discharged in the full-discharge test (40 CFR 600.116-12(a)(8))",
    "dc_wh_per_mi": "DC energy per mile on the UDDS (weighted over the four UDDS of the Multi-Cycle Test) and on the highway cycle (mean of the two)",
    "recharge": "AC energy taken from the mains to recharge after the test",
    "charging_efficiency": "usable battery energy / recharge energy (computed here)",
    "constant_65_mph_dc_wh_per_mi": "DC energy per mile in the constant-speed phases of the Multi-Cycle Test, driven at 65 mph (40 CFR 600.116-12(a)(5))"
  },
